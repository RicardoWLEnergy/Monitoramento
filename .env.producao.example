# Modelo das configurações de PRODUÇÃO (Docker). Este arquivo vai para o git, SEM senhas.
# No servidor: copie para ".env" (na mesma pasta do docker-compose.yml) e preencha.

# ---------- Endereço ----------
# Sem domínio: https://IP_DO_SERVIDOR  | Com domínio: monitoramento.wlenergy.com.br
SITE_ADDRESS=https://IP_DO_SERVIDOR
# Sem domínio: internal (certificado próprio)  | Com domínio: um e-mail (avisos do certificado)
TLS_MODO=internal

# ---------- Django ----------
DJANGO_SECRET_KEY=gere-uma-chave-nova
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=IP_DO_SERVIDOR
DJANGO_CSRF_TRUSTED_ORIGINS=https://IP_DO_SERVIDOR
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br

# ---------- Banco (o contêiner cria o banco e o usuário com estes dados) ----------
# A senha deve ter SÓ letras e números (ela vai dentro de um endereço postgres://...)
POSTGRES_DB=monitoramento
POSTGRES_USER=wl_monitoramento
POSTGRES_PASSWORD=gere-uma-senha-longa-so-letras-e-numeros

# ---------- Integrações ----------
FOXESS_API_URL=https://www.foxesscloud.com
FOXESS_API_KEY=
HUAWEI_API_URL=https://la5.fusionsolar.huawei.com/thirdData
HUAWEI_USUARIO=
HUAWEI_SENHA=
