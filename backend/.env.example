# Copie para .env e preencha os valores. Este arquivo É versionado.

DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br

DATABASE_URL=postgres://usuario:senha@localhost:5432/monitoramento

CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

WEG_API_URL=
WEG_USUARIO=
WEG_SENHA=

FOXESS_API_URL=https://www.foxesscloud.com
FOXESS_API_KEY=

# Huawei: host = o mesmo do portal web da empresa após o login (ex.: la5) + /thirdData
# Usuário/senha = conta Northbound (System > Company Management > Northbound Management)
HUAWEI_API_URL=https://la5.fusionsolar.huawei.com/thirdData
HUAWEI_USUARIO=
HUAWEI_SENHA=
