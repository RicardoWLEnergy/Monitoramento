# Modelo das configurações (este arquivo É versionado; os valores reais NUNCA).
# - No computador: copie para backend/.env e preencha.
# - No servidor (Docker): copie para .env na RAIZ do projeto, preencha e complete a parte "Só no servidor" no fim.

DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br

DATABASE_URL=postgres://usuario:senha@localhost:5432/monitoramento

CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

WEG_API_URL=
WEG_USUARIO=
WEG_SENHA=

FOXESS_API_URL=https://www.foxesscloud.com
FOXESS_API_KEY=

# Huawei: host = o mesmo do portal web da empresa após o login (ex.: la5) + /thirdData
# Usuário/senha = conta Northbound (System > Company Management > Northbound Management)
HUAWEI_API_URL=https://la5.fusionsolar.huawei.com/thirdData
HUAWEI_USUARIO=
HUAWEI_SENHA=

# uazapi (WhatsApp): código de acesso no login
# URL = endereço do servidor que aparece no painel da uazapi (ex.: https://SEU-SERVIDOR.uazapi.com)
# TOKEN = token da INSTÂNCIA (não o admintoken)
UAZAPI_URL=
UAZAPI_TOKEN=

# Google: planilha OBRAS e documentos do cliente (tela "Meu projeto"), por uma conta de serviço (só leitura)
# GOOGLE_CREDENCIAIS = conteúdo do arquivo JSON da chave da conta de serviço, em base64 (uma linha só)
# PLANILHA_OBRAS_ID = o código no endereço da planilha: docs.google.com/spreadsheets/d/<ESTE CÓDIGO>/edit
GOOGLE_CREDENCIAIS=
PLANILHA_OBRAS_ID=
PLANILHA_OBRAS_ABA=OBRAS

# Clima do dia (Open-Meteo). Vazio = uso gratuito (só NÃO comercial). Com o plano comercial, coloque a chave.
OPEN_METEO_CHAVE=

# ---------- Só no servidor (Docker) ----------
# No servidor: DJANGO_DEBUG=False, DJANGO_ALLOWED_HOSTS=<domínio>, CORS_ALLOWED_ORIGINS=https://<domínio>.
# A DATABASE_URL acima é montada pelo docker-compose a partir destas três (senha só com letras e números):
# POSTGRES_DB=monitoramento
# POSTGRES_USER=wl_monitoramento
# POSTGRES_PASSWORD=
# Endereço do site e certificado (ver o topo do Caddyfile):
#   com domínio → SITE_ADDRESS=monitoramento.wlenergy.com.br e TLS_MODO=<e-mail para o certificado oficial>
#   sem domínio → SITE_ADDRESS=https://IP_DO_SERVIDOR e TLS_MODO=internal
# SITE_ADDRESS=
# TLS_MODO=
